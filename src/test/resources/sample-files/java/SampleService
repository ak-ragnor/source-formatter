    /**
     * A method with high complexity
     */
    public String   complexMethod(  int value, String type )   {

        if (value < 0) {
            System.out.println("Negative");
            if (type.equals("strict")) {
                throw new IllegalArgumentException("Negative not allowed in strict mode");
            } else if (type.equals("convert")) {
                value = -value;
            } else {
                System.out.println("Using default handling for negative");
            }
        } else if (value == 0) {
            System.out.println("Zero");
            if (type.equals("strict")) {
                return "zero-strict";
            } else {
                return "zero-regular";
            }
        } else if (value < 10) {
            System.out.println("Small");
            for (int i = 0; i < value; i++) {
                if (i % 2 == 0) {
                    System.out.println("Even: " + i);
                } else {
                    System.out.println("Odd: " + i);
                }
            }
            return "small-" + type;
        } else if (value < 100) {
            System.out.println("Medium");
            switch (type) {
                case "strict":
                    return "medium-strict";
                case "convert":
                    return "medium-convert";
                default:
                    return "medium-default";
            }
        } else {
            System.out.println("Large");


            if (type.equals("strict")) {
                if (value > 1000) {
                    return "very-large-strict";
                } else {
                    return "large-strict";
                }
            } else {
                return "large-default";
            }
        }

        return "default-fallback";
    }

    /**
